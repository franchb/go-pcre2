# Builds PCRE2 to WebAssembly and translates it to Go with wasm2go.
#
#   podman build -f buildtools/wasm/Containerfile -t go-pcre2-build .
#   podman run --rm -v "$PWD/internal/wasm:/out:Z" go-pcre2-build
#
# Works the same with docker. See the Makefile.

FROM ghcr.io/webassembly/wasi-sdk:wasi-sdk-25 AS wasm

RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates git wabt \
  && rm -rf /var/lib/apt/lists/*

COPY buildtools/wasm/versions.env buildtools/wasm/exports.txt /build/

# Fetch the pinned release and refuse to build if the tag moved.
RUN . /build/versions.env \
  && git clone --quiet --depth 1 --branch "$PCRE2_TAG" https://github.com/PCRE2Project/pcre2 /pcre2 \
  && test "$(git -C /pcre2 rev-parse HEAD)" = "$PCRE2_COMMIT"

# The JIT has no WebAssembly backend (doc/pcre2jit.3), so it stays off.
RUN cmake -S /pcre2 -B /pcre2/build \
    -DCMAKE_TOOLCHAIN_FILE=/opt/wasi-sdk/share/cmake/wasi-sdk.cmake \
    -DCMAKE_BUILD_TYPE=Release \
    -DBUILD_SHARED_LIBS=OFF \
    -DBUILD_STATIC_LIBS=ON \
    -DPCRE2_BUILD_PCRE2_8=ON \
    -DPCRE2_BUILD_PCRE2_16=OFF \
    -DPCRE2_BUILD_PCRE2_32=OFF \
    -DPCRE2_SUPPORT_JIT=OFF \
    -DPCRE2_SUPPORT_UNICODE=ON \
    -DPCRE2_BUILD_PCRE2GREP=OFF \
    -DPCRE2_BUILD_TESTS=OFF \
  && cmake --build /pcre2/build -j"$(nproc)"

# A reactor module: no main, _initialize runs libc constructors.
RUN exports="$(sed 's/^/-Wl,--export=/' /build/exports.txt | tr '\n' ' ')" \
  && $CC -O2 -mexec-model=reactor \
    -o /build/pcre2.wasm \
    /pcre2/build/libpcre2-8.a \
    -Wl,-z,stack-size=1048576 \
    $exports

# The module must not import anything: no WASI, no host functions.
# A Regexp then has no way to reach files, clocks, the network or the
# process, whatever the pattern or subject.
RUN imports="$(wasm-objdump -j Import -x /build/pcre2.wasm | grep -c ' <- ' || true)" \
  && if [ "$imports" != "0" ]; then \
       wasm-objdump -j Import -x /build/pcre2.wasm; \
       echo "pcre2.wasm has $imports imports; expected none" >&2; exit 1; \
     fi \
  && sha256sum /build/pcre2.wasm

FROM golang:1.26-trixie

COPY --from=wasm /build/pcre2.wasm /build/versions.env /build/
WORKDIR /build
SHELL ["/bin/bash", "-c"]

RUN . ./versions.env \
  && go run "github.com/ncruces/wasm2go@${WASM2GO_VERSION}" -unsafe -pkg=wasm -o pcre2.wasm.go pcre2.wasm \
  && pcre2_version="${PCRE2_TAG#pcre2-}" \
  && sum="$(sha256sum pcre2.wasm | cut -d' ' -f1)" \
  && printf '%s\n' \
    '// Code generated by buildtools/wasm/Containerfile. DO NOT EDIT.' \
    '' \
    'package wasm' \
    '' \
    '// Inputs that produced pcre2.wasm.go.' \
    'const (' \
    "	PCRE2Version   = \"${pcre2_version}\"" \
    "	PCRE2Commit    = \"${PCRE2_COMMIT}\"" \
    "	Wasm2GoVersion = \"${WASM2GO_VERSION}\"" \
    "	WasmSHA256     = \"${sum}\"" \
    ')' > versions.go \
  && gofmt -w versions.go

CMD ["bash", "-c", "cp /build/pcre2.wasm.go /build/versions.go /out/"]
